// SPDX-License-Identifier: Apache-2.0
//
// Apps for every o1s variant. Only installed when mack-apps.mk puts this
// namespace into PRODUCT_SOONG_NAMESPACES. The APKs come from fetch-blobs.sh
// (pinned in blobs.txt).

soong_namespace {
}

// Aurora Store is GPL-3.0-or-later. license_text puts the licence into the
// product partition's NOTICE file (Settings > About phone > Legal information
// > Third-party licences). The source is tag 4.8.4 of
// https://gitlab.com/AuroraOSS/AuroraStore (see README.md).
license {
    name: "vendor_mack-apps_AuroraStore_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-GPL-3.0-or-later"],
    license_text: ["LICENSE.GPL-3.0"],
}

// Apache-2.0: the code of this repo (MackAppInstaller).
license {
    name: "vendor_mack-apps_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
}

// MackAppInstaller: installs Aurora Store once per user as a normal user app,
// so it can be uninstalled, downgraded or replaced (README.md). No UI, no
// network. Aurora's APK is an asset of this APK, byte for byte the pinned
// file (blobs.txt): no extra .apk lands in target-files, so
// sign_target_files_apks only re-signs this app (default key -> releasekey)
// and never touches Aurora's signature. Both licences apply to this APK.
android_app {
    name: "MackAppInstaller",
    licenses: [
        "vendor_mack-apps_license",
        "vendor_mack-apps_AuroraStore_license",
    ],
    srcs: ["MackAppInstaller/src/**/*.java"],
    manifest: "MackAppInstaller/AndroidManifest.xml",
    asset_dirs: ["prebuilt/AuroraStore"],
    sdk_version: "current",
    privileged: true,
    privapp_allowlist: "MackAppInstaller/privapp_allowlist.xml",
    product_specific: true,
    optimize: {
        enabled: false,
    },
}
